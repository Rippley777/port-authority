{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Port Authority",
  "version": "0.1.1",
  "identifier": "dev.portauthority.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Port Authority",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#111315",
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Know what's listening.",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../shell/port-authority.sh": "shell/port-authority.sh"
    }
  }
}
